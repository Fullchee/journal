# Every value here is public: the app inlines it into the JS bundle.
# Never add a secret; anything secret belongs in the `journal` Worker.
# @defaultSensitive=false
# @defaultRequired=false
# @generateTsTypes(path='src/env.d.ts')
# ---

# Cloudflare Access team domain that hosts the Managed OAuth endpoints.
# @required
EXPO_PUBLIC_ACCESS_TEAM_DOMAIN=fullchee.cloudflareaccess.com

# Public OAuth client registered in Access (PKCE, no secret).
# @required @type=string(isLength=36)
EXPO_PUBLIC_ACCESS_CLIENT_ID=

# Overrides for Access's OAuth endpoints, e.g. a local mock.
# @required @type=url
EXPO_PUBLIC_ACCESS_AUTHORIZE_URL=https://${EXPO_PUBLIC_ACCESS_TEAM_DOMAIN}/cdn-cgi/access/oauth/authorization
# @required @type=url
EXPO_PUBLIC_ACCESS_TOKEN_URL=https://${EXPO_PUBLIC_ACCESS_TEAM_DOMAIN}/cdn-cgi/access/oauth/token

# API origin; in development, point it at `wrangler dev` here.
# Unset: web uses its own origin, native uses production.
# @type=url
EXPO_PUBLIC_API_URL=

# Sentry DSN for the one project Android and web share; public by design, since the client sends it with every event.
# Unset: Sentry stays off and sends nothing.
# @type=url
EXPO_PUBLIC_SENTRY_DSN=
