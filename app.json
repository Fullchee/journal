{
  "expo": {
    "name": "Journal",
    "slug": "journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dev.fullchee.journal",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f3eee2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.fullchee.journal",
      "permissions": [
        "android.permission.health.READ_MINDFULNESS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3eee2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#141811",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-contacts",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos to add to your Habits and notes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "./plugins/android-shortcuts.ts",
        {
          "shortcuts": [
            {
              "id": "check-in",
              "label": "Check in",
              "path": "?focus=check-in"
            },
            {
              "id": "log",
              "label": "Log",
              "path": "log"
            },
            {
              "id": "health-plan",
              "label": "Health plan",
              "path": "health-plan"
            }
          ]
        }
      ],
      "./plugins/release-signing.ts",
      "react-native-notify-kit",
      "./modules/journal-android/app.plugin.ts",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "journal",
          "organization": "fullchee"
        }
      ],
      "expo-background-task",
      ["expo-audio", { "recordAudioAndroid": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2e3d721d-5780-4640-a28a-7c097ca31f0c"
      }
    },
    "owner": "fullchee",
    "updates": {
      "url": "https://u.expo.dev/2e3d721d-5780-4640-a28a-7c097ca31f0c",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
