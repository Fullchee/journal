<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed Tint inside the plate's hairline while a whole-plate button is pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_pressed_tint" />
            <stroke android:width="1dp" android:color="@color/widget_hairline" />
            <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
