<?xml version="1.0" encoding="utf-8"?>
<!-- An engraved plate: Plate Cream ground (Night Ground in dark mode) in a Sepia Edge border, doubled by a hairline 3dp inside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_ground" />
            <stroke android:width="1dp" android:color="@color/widget_edge" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_hairline" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
