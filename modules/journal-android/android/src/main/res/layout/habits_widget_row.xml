<?xml version="1.0" encoding="utf-8"?>
<!-- One open Habit: its name opens the Habit, the tick marks it done today. A timed Habit has no tick. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:background="@drawable/widget_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/habit_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:background="@drawable/widget_press"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/habit_tick"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_press"
        android:padding="8dp"
        android:src="@drawable/widget_icon_check" />
</LinearLayout>
