<?xml version="1.0" encoding="utf-8"?>
<!-- The whole plate is one button: a pencil over a small-caps "Log". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/log_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_press"
        android:contentDescription="@string/log_widget_open"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_icon_log" />

        <TextView
            style="@style/WidgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/log_widget_label"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
