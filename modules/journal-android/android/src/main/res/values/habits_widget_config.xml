<?xml version="1.0" encoding="utf-8"?>
<!-- The filter screen is a system dialog, so it looks like the phone's own settings; values-night holds the dark one. -->
<resources>
    <style name="HabitsWidgetConfig" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />

    <style name="HabitsFilterLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
