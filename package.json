{
  "name": "journal-native",
  "private": true,
  "type": "module",
  "main": "src/entry.ts",
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('bun/')){console.error('Use bun, not npm or pnpm: bun install');process.exit(1)}\"",
    "postinstall": "expo customize tsconfig.json",
    "check": "node scripts/check.ts",
    "lint": "oxfmt --check && oxlint && bun run lint:css && bun run lint:sh && bun run lint:conventions",
    "format": "oxfmt",
    "lint:conventions": "node scripts/check-conventions.ts",
    "lint:css": "stylelint \"**/*.css\" --max-warnings=0 --cache --cache-location node_modules/.cache/stylelint/",
    "lint:sh": "node scripts/lint-sh.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p tsconfig.node.json",
    "test": "jest --coverage && bun run test:core --coverage && bun run test:api --coverage && node --test 'tools/oxlint/**/*.test.ts' '.claude/skills/**/*.test.ts' 'scripts/*.test.ts'",
    "fallow": "node scripts/merge-coverage.ts && fallow --quiet --fail-on-issues --coverage coverage/coverage-final.json",
    "coverage:gaps": "node scripts/coverage-gaps.ts",
    "fallow:changed": "fallow --quiet --fail-on-issues --changed-since origin/main",
    "secrets:scan": "uv tool run --from detect-secrets==1.5.0 detect-secrets scan --baseline .secrets.baseline",
    "start": "expo start",
    "web": "expo start --web",
    "android:emulator": "expo run:android",
    "android:phone": "expo run:android --device",
    "android:apk": "scripts/build-apk.sh",
    "android:phone:apk": "scripts/build-apk.sh --install",
    "e2e": ".maestro/run.sh",
    "emulator": "scripts/emulator.sh",
    "screenshot:web": "scripts/web-preview.sh node scripts/screenshot-web.ts",
    "test:api": "jest --config worker/jest.config.ts",
    "test:core": "jest --config jest.core.config.ts",
    "deploy": "scripts/deploy.sh"
  },
  "dependencies": {
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@expo-google-fonts/alegreya-sans": "^0.4.2",
    "@expo-google-fonts/alegreya-sans-sc": "^0.4.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@rn-primitives/avatar": "1.5.2",
    "@rn-primitives/dialog": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/switch": "1.5.2",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "babel-preset-expo": "~58.0.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-contacts": "~58.0.10",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-health-connect": "4.1.3",
    "react-native-notify-kit": "^10.10.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "sonner": "2.0.8",
    "sonner-native": "0.27.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.13.2",
    "varlock": "^1.24.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@oxlint/plugins": "1.92.0",
    "@react-native/assets-registry": "0.88.1",
    "@shadcn/lint": "0.2.5",
    "@testing-library/react-native": "^14.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@varlock/expo-integration": "^1.2.2",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "fallow": "^3.40.0",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.158.0"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "engines": {
    "bun": ">=1.4 <2",
    "node": ">=26 <27"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "workerd"
  ]
}
