{
  "extends": "../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2025.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["jest", "node"],
    "paths": {
      "@worker/*": ["./*"],
      "@/core": ["../src/core"],
      "@/core/*": ["../src/core/*"]
    }
  },
  "include": ["**/*.ts"]
}
