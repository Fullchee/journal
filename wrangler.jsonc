{
  "name": "journal",
  "main": "worker/index.ts",
  "tsconfig": "worker/tsconfig.json",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fullchee-dashboard",
      "database_id": "d8a663b9-eab7-4caf-a5d1-500d545043ea",
      "migrations_dir": "worker/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "fullchee-dashboard-attachments" }],
  "ai": { "binding": "AI" },
  // HEVY_SYNC_CRON and EVENING_REVIEW_CRON in worker/index.ts; the free plan allows 5 crons per account.
  "triggers": { "crons": ["23 7 * * *", "47 8 * * *"] },
  "vars": {
    "TEAM_DOMAIN": "fullchee.cloudflareaccess.com",
    // AUD tags of the Access apps that may guard journal.fullchee.workers.dev: fullchee-dashboard, then the workers.dev app.
    "POLICY_AUD": "8a5b42e91e685b89a88287dfc2a39f05ce32d98e28c15ad7c4e69f5baad4bf90,71f531e12882158ca95fc93f8092664f5d3b1e26d6190cf052691b4f78c55dd4",
  },
  // Secrets (wrangler secret put; locally, .dev.vars): OWNER_EMAIL, HEVY_HABIT, TODOIST_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN.
}
